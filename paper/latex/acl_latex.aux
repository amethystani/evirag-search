\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Per-domain CR and CCS: Vanilla RAG (Van) vs.\ \textsc  {EVIRAG}\xspace  \ Full. All per-domain CR differences are significant ($p{<}0.05$, Wilcoxon, uncorrected; 50 queries per domain). \textsc  {EVIRAG}\xspace  \ Full improves CR in every domain, with larger gains in domains with clearer bipolar controversy structure (economics, education) and smaller gains in domains with multi-factorial disagreement (nutrition, earth sciences).}}{10}{table.caption.38}\protected@file@percent }
\newlabel{tab:perdomain}{{3}{10}{Per-domain CR and CCS: Vanilla RAG (Van) vs.\ \system \ Full. All per-domain CR differences are significant ($p{<}0.05$, Wilcoxon, uncorrected; 50 queries per domain). \system \ Full improves CR in every domain, with larger gains in domains with clearer bipolar controversy structure (economics, education) and smaller gains in domains with multi-factorial disagreement (nutrition, earth sciences)}{table.caption.38}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces 35B validation battery (\texttt  {qwen3.6:35b-a3b}, RTX 4500 Ada). Task B $\kappa =0.883$ exceeds the ``almost perfect'' threshold (0.80). Task D Vanilla VC $=0.667$; keyword-based VC is more permissive than the embedding-based VC used in the structural collapse argument (\S  \ref {sec:collapse-argument}) --- the vanilla response missed V2 entirely (null-result meta-analytic view, keyword hits $=0$).}}{10}{table.caption.39}\protected@file@percent }
