\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Main results on \textsc  {EVIRAG-Bench}\xspace  \ (250 queries, 5 domains $\times $ 50 queries) using \texttt  {qwen3.6:35b-a3b} via Ollama (\texttt  {think=False}). Upper block: internal ablations. Middle block: external baselines. VC$_{\text  {emb}}$: dense-encoder viewpoint coverage. FS: FaithfulnessScore. $\pm $: bootstrap 95\% CI half-width. $^\dagger $: \textsc  {EVIRAG}\xspace  \ Full is significantly better ($p{<}0.05$, paired Wilcoxon, Bonferroni-corrected) for CR against all systems and for VC$_\text  {emb}$ against all systems. CCS differences between \textsc  {EVIRAG}\xspace  \ Full and MMR-RAG are not significant ($p{=}0.11$); all other CCS comparisons are significant. VC$_\text  {kw}$ shows near-ceiling performance (0.892--0.991) across systems, indicating keyword-level coverage is too coarse to discriminate; the primary viewpoint-coverage signal comes from VC$_\text  {emb}$ and human evaluation.}}{7}{table.caption.23}\protected@file@percent }
\newlabel{tab:ablation}{{2}{7}{Main results on \bench \ (250 queries, 5 domains $\times $ 50 queries) using \texttt {qwen3.6:35b-a3b} via Ollama (\texttt {think=False}). Upper block: internal ablations. Middle block: external baselines. VC$_{\text {emb}}$: dense-encoder viewpoint coverage. FS: FaithfulnessScore. $\pm $: bootstrap 95\% CI half-width. $^\dagger $: \system \ Full is significantly better ($p{<}0.05$, paired Wilcoxon, Bonferroni-corrected) for CR against all systems and for VC$_\text {emb}$ against all systems. CCS differences between \system \ Full and MMR-RAG are not significant ($p{=}0.11$); all other CCS comparisons are significant. VC$_\text {kw}$ shows near-ceiling performance (0.892--0.991) across systems, indicating keyword-level coverage is too coarse to discriminate; the primary viewpoint-coverage signal comes from VC$_\text {emb}$ and human evaluation}{table.caption.23}{}}
